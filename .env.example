# MongoDB connection
# Local dev: run a local mongo:4.4 and import the backup (see PLAN.md §8)
# Production (ECS): mongodb://127.0.0.1:27017/aimeeblog
MONGODB_URI=mongodb://127.0.0.1:27017/aimeeblog

# Auth.js secret (generate: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-random-secret

NODE_ENV=development
