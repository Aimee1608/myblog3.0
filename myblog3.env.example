# Copy to /root/myblog3.env on the ECS host (do NOT commit the real one).
# Used by deploy.sh via `docker run --env-file`.

# Reuse the existing MongoDB on the host (host network -> 127.0.0.1)
MONGODB_URI=mongodb://127.0.0.1:27017/aimeeblog

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=__REPLACE_WITH_RANDOM__
AUTH_URL=https://mangoya.cn

# GitHub OAuth App credentials (create at https://github.com/settings/developers)
AUTH_GITHUB_ID=__REPLACE__
AUTH_GITHUB_SECRET=__REPLACE__

# Comma-separated GitHub logins treated as admins
ADMIN_USER_IDS=Aimee1608

NODE_ENV=production
PORT=3000
# Bind to localhost only; nginx terminates TLS and proxies to it
HOSTNAME=127.0.0.1
